{
  "name": "intellinote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node tools/set-vite-env.mjs dev vite",
    "build": "node tools/set-vite-env.mjs build vite build",
    "build:info": "node tools/build-info.mjs",
    "build:asr": "node tools/build-asr.mjs",
    "test:asr": "cargo test --manifest-path src-tauri/asr/Cargo.toml --locked && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "preview": "vite preview",
    "tauri": "tauri",
    "start-desktop": "npm run tauri dev",
    "build-desktop": "npm run tauri build",
    "package:mac:test": "npm run verify:platforms && npm run tauri:build:unsigned && node tools/package-mac-test.mjs",
    "tauri:build:unsigned": "node tools/release-tauri.mjs --unsigned",
    "tauri:build:signed": "RELEASE_BUILD=1 node tools/release-tauri.mjs --signed",
    "start-mobile": "npm run build && npx cap sync && (npx cap open android || npx cap open ios)",
    "sync-mobile": "npm run build && npx cap sync",
    "native:ios:gen": "npm run build && npx cap sync ios",
    "native:ios:open": "npx cap open ios",
    "native:android:gen": "npm run build && npx cap sync android",
    "native:android:open": "npx cap open android",
    "ios:archive": "node tools/ios-archive.mjs",
    "android:assemble:release": "cd android && ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "verify:platforms": "tsx verification_scripts/verify_platforms.ts",
    "verify:providers": "tsx verification_scripts/verify_providers.ts",
    "verify:release": "node tools/verify-release.mjs",
    "test:transcript": "tsx verification_scripts/transcript_pipeline.test.ts",
    "test:unit": "tsx verification_scripts/unit.test.ts",
    "test:storage": "tsx verification_scripts/storage.test.ts",
    "test": "npm run test:unit && npm run test:transcript && npm run test:storage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^1.52.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "2.8.3",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.7.2",
    "react-quill-new": "^3.8.3",
    "react-resizable": "^3.2.0",
    "turndown": "^7.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fake-indexeddb": "^6.2.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^7.3.7"
  }
}
