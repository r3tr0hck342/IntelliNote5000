{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright \u00a9 2024 IntelliNote. All rights reserved.",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "An intelligent note-taking application that listens to lectures in real-time, organizes notes, and generates study materials to enhance your learning experience.",
    "macOS": {
      "entitlements": "entitlements.plist",
      "frameworks": [],
      "hardenedRuntime": true,
      "providerShortName": null,
      "signingIdentity": "-",
      "dmg": {
        "windowPosition": {
          "x": 418,
          "y": 272
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 192,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 468,
          "y": 180
        }
      }
    },
    "resources": [],
    "shortDescription": "An AI-powered note-taking assistant for lectures.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "IntelliNote",
  "mainBinaryName": "IntelliNote",
  "version": "0.1.0",
  "identifier": "com.intellinote.app",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "height": 720,
        "resizable": true,
        "title": "IntelliNote - AI Lecture Assistant",
        "width": 1280,
        "minWidth": 800,
        "minHeight": 600,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost 'self' https://generativelanguage.googleapis.com https://api.openai.com https://api.deepgram.com wss://api.deepgram.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:;"
    }
  }
}
